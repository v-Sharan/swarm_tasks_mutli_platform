// Configuration file for the swarm fleet-management backend (a stripped,
// re-purposed fork of Skybrush Server with the drone-light-show extensions
// removed), bridged to this project's own main.py/swarm.py process via the
// swarm_bridge extension.
//
// The file is essentially a JSON file, but C-style comments are allowed, and
// lines starting with a hash are ignored.

{
  "EXTENSIONS": {
    // Make the server listen on all interfaces so it can be connected to
    // from the GCS operator machine running the "live" frontend
    "http_server": {
      "host": ""
    },

    // Bridges to main.py: sends commands over UDP in main.py's exact wire
    // format and polls main.py's /api/telemetry for live bot state.
    // command_host/telemetry_url MUST point at the LAN IP main.py printed
    // at startup ("Ip address: ..."); there is no discovery mechanism.
    "swarm_bridge": {
      "enabled": true,
      "num_bots": 10,
      "command_host": "127.0.0.1",
      "command_port": 12008,
      "telemetry_url": "http://127.0.0.1:8765/api/telemetry",
      "poll_interval": 0.5
    }
  }
}
